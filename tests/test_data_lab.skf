пусть data_lab = подтянуть "skf-data-lab"

@тест("Загрузка и сводка")
функция тест_загрузка() {
    // Создаём тестовый CSV
    пусть файл = открыть("test.csv", "w")
    файл.записать("x,y,z\n1,2,3\n4,5,6\n7,8,9\n")
    файл.закрыть()
    
    пусть таблица = data_lab.загрузить_таблицу("test.csv")
    ожидать_равно(таблица.shape[0], 3)
    ожидать_равно(таблица.shape[1], 3)
    
    удалить("test.csv")
}

@тест("Обучение регрессии")
функция тест_регрессия() {
    пусть файл = открыть("test.csv", "w")
    файл.записать("x,y\n1,2\n2,4\n3,6\n4,8\n5,10\n")
    файл.закрыть()
    
    пусть таблица = data_lab.загрузить_таблицу("test.csv")
    пусть модель = data_lab.обучить_регрессию(таблица, "y")
    
    // Проверяем, что модель обучилась
    ожидать_истина(модель != ничто)
    
    удалить("test.csv")
}
