пусть pd = подключить_питон("pandas")

// Загрузить CSV или Excel
функция загрузить_таблицу(путь, формат = "csv") {
    если формат == "csv" {
        вернуть pd.read_csv(путь)
    } иначе если формат == "excel" {
        вернуть pd.read_excel(путь)
    } иначе {
        бросить "Неподдерживаемый формат: " + формат
    }
}

// Сохранить таблицу
функция сохранить_таблицу(таблица, путь) {
    таблица.to_csv(путь, index=ложь)
    лог("Сохранено: " + путь)
}

// Краткая сводка по данным
функция сводка(таблица) {
    лог("Размер: " + таблица.shape)
    лог("Колонки: " + таблица.columns.tolist())
    лог("Пропуски:\n" + таблица.isnull().sum().to_string())
    лог("Описательная статистика:\n" + таблица.describe().to_string())
}
